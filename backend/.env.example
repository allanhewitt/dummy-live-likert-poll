# Copy this file to .env and fill in your real values.
# Never commit the real .env file to GitHub.

# Connection string for the dedicated dummy database.
# Example: postgres://username:password@host:5432/gedl_dummy_test
DATABASE_URL=postgres://username:password@localhost:5432/gedl_dummy_test

# Port the API listens on locally. Coolify will set its own PORT in production.
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
# Add your local dev URL now, and your deployed frontend URL once it exists.
ALLOWED_ORIGINS=http://localhost:5173
